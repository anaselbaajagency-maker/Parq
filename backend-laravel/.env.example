APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STRUCTURED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parq
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# For SaaS production readiness prefer: QUEUE_CONNECTION=redis
QUEUE_JOB_TRIES=3
QUEUE_JOB_BACKOFF_SECONDS=60
QUEUE_BILLING_QUEUE=billing
PERF_MEDIA_QUEUE=media
QUEUE_FAILED_PRUNE_HOURS=168
QUEUE_BATCH_PRUNE_HOURS=168

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS / API security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_SUPPORTS_CREDENTIALS=false
SANCTUM_TOKEN_EXPIRATION=10080
TOPUP_PROOF_URL_TTL_MINUTES=10
AUDIT_LOG_CHANNEL=audit
AUDIT_LOG_LEVEL=info
AUDIT_LOG_DAYS=30
SENTRY_ENABLED=false
SENTRY_BACKEND_DSN=
SENTRY_HTTP_TIMEOUT=2
REQUEST_ID_HEADER=X-Request-ID
SETTINGS_CACHE_TTL_SECONDS=30
MAINTENANCE_BYPASS_HEADER=X-Maintenance-Bypass
MAINTENANCE_BYPASS_TOKEN=
PERF_CACHE_ENABLED=true
PERF_PUBLIC_CACHE_TTL_SECONDS=60
PERF_STALE_WHILE_REVALIDATE_SECONDS=30
PERF_MAX_PER_PAGE=50
PERF_DEFAULT_PER_PAGE=15
PERF_CURSOR_PARAM=pagination
PERF_CURSOR_VALUE=cursor
DB_QUERY_PROFILING_ENABLED=false
DB_SLOW_QUERY_THRESHOLD_MS=300

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api"
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_WEB_VITALS_ENDPOINT=
